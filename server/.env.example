# Đăng nhập (bắt buộc khi deploy public). Bỏ trống -> không khóa.
APP_PASSWORD=
# Khóa ký token (bỏ trống -> dùng APP_PASSWORD)
APP_SECRET=

# MongoDB Atlas. Thay <cluster> bằng host trong Atlas -> Connect (vd cluster0.xxxxx.mongodb.net)
MONGODB_URI=
MONGODB_DB=music

# Cloudinary. Điền từ Dashboard -> API Keys (dạng cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=music-app
